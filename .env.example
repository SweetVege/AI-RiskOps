DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Optional. Requests per minute allowed per application credential on the ingestion API (default 600, 0 disables).
# INGEST_RATE_LIMIT_PER_MINUTE=600
# Optional. Maximum Postgres connections per server instance.
# DATABASE_POOL_MAX=5

# Sign-in (required unless DEMO_MODE=true). Generate AUTH_SECRET with: openssl rand -base64 32
# Create a GitHub OAuth app with callback URL <your origin>/api/auth/callback/github
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Comma-separated emails that become Platform Admin on first sign-in.
AUTH_ADMIN_EMAILS=""
# Set to true for a public read-only demo with the simulated profile switcher and no sign-in.
# DEMO_MODE=true
