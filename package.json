{
  "name": "ai-riskops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "pnpm run test:contracts && pnpm run prisma:generate && next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "preview": "pnpm build && pnpm start",
    "lint": "eslint .",
    "test:contracts": "node scripts/check-risk-status-contract.mjs",
    "replay:sample": "node scripts/replay-real-sample.mjs",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "pnpm run db:push && pnpm run db:seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node node_modules/prisma/build/index.js migrate deploy"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-socket": "^0.2.12",
    "@eslint/eslintrc": "^3.3.7",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.4.49",
    "postcss-selector-parser": "6.1.4",
    "prisma": "7.9.1",
    "tailwindcss": "^3.4.17",
    "vitest": "^5.0.4"
  }
}
